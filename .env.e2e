# E2E environment — a second app instance on :8080, backed by a throwaway
# SQLite file, so browser tests never touch the local MySQL dev database.
#
#   ./vendor/bin/sail artisan migrate:fresh --seed --env=e2e
#   ./vendor/bin/sail artisan serve --env=e2e --host=0.0.0.0 --port=8080
#
# Both are wrapped by `npm run e2e`. Committed on purpose: no secrets here,
# the APP_KEY is the same throwaway one phpunit.xml uses.

APP_NAME=Esperluettes
APP_ENV=e2e
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Same locale as dev: the flows assert against the French UI.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Throwaway database, dropped and reseeded before every run.
DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

# Cheap hashing: the seeder creates a dozen accounts and every flow logs in.
BCRYPT_ROUNDS=4

# File-backed, not database-backed: the SQLite file is wiped between runs and
# `database` drivers would drag session/cache tables into the reset.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
CACHE_PREFIX=e2e
QUEUE_CONNECTION=sync

# Same host as the dev app, different port — cookies are NOT port-scoped, so
# without a distinct name an E2E run would log you out of your dev browser tab.
SESSION_COOKIE=esperluettes_e2e_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Keep every compiled artefact out of bootstrap/cache, which the dev app owns.
APP_CONFIG_CACHE=/tmp/laravel-config-e2e.php
APP_ROUTES_CACHE=/tmp/laravel-routes-e2e.php
APP_EVENTS_CACHE=/tmp/laravel-events-e2e.php
APP_PACKAGES_CACHE=/tmp/laravel-packages-e2e.php
VIEW_COMPILED_PATH=/tmp/laravel-views-e2e

VITE_APP_NAME="${APP_NAME}"
VITE_BUILD_DETERMINISTIC=true

# Matches dev, so the registration flow behaves the same.
REQUIRE_ACTIVATION_CODE=true

DISCORD_URL=https://discord.gg/Esperluettes
