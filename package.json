{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.21.0",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "vitest run",
        "gate": "node scripts/gate.js",
        "worktree": "node scripts/worktree.js",
        "add-task": "node scripts/add-task.js",
        "package": "node scripts/package.js",
        "prepare": "husky",
        "dep:check": "./vendor/bin/sail composer deptrac",
        "husky:precommit": "node scripts/husky-precommit.js",
        "launch-staged:tests": "node scripts/launch_staged_tests.js",
        "launch-deptrac": "node scripts/launch_deptrac.js",
        "e2e": "playwright test",
        "e2e:core": "playwright test e2e/tests/core",
        "e2e:ui": "playwright test --ui",
        "e2e:report": "playwright show-report",
        "e2e:setup": "playwright install chromium",
        "browser:setup": "node .agents/skills/run-app/setup.mjs",
        "browser:drive": "node .agents/skills/run-app/driver.mjs"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.2.4",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/user-event": "^14.5.2",
        "archiver": "^8.0.0",
        "autoprefixer": "^10.5.0",
        "concurrently": "^10.0.5",
        "dotenv": "^18.0.4",
        "happy-dom": "^20.11.1",
        "husky": "^9.1.7",
        "js-yaml": "^5.4.2",
        "laravel-vite-plugin": "^2.1.0",
        "playwright": "^1.62.0",
        "tailwindcss": "^4.2.4",
        "typescript": "^7.0.2",
        "vite": "^7.3.2",
        "vitest": "^5.0.2"
    },
    "dependencies": {
        "@alpinejs/intersect": "3.17.4",
        "alpinejs": "3.17.4",
        "axios": "1.20.0",
        "chart.js": "^4.5.1",
        "chartjs-adapter-date-fns": "^3.0.0",
        "date-fns": "^4.4.0",
        "quill": "2.0.3",
        "quill-delta": "5.1.0",
        "uuid": "14.0.2"
    }
}
